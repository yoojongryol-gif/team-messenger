rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 로그인한 사람만 전체 접근 가능 (사내 팀 도구 기준)
    function signedIn() { return request.auth != null; }
    function isMember(room) { return request.auth.uid in room.data.members; }

    // 사용자: 본인 문서만 수정, 목록은 로그인 시 조회 가능
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if request.auth.uid == uid;
      allow delete: if false;
    }

    // 채팅방: 멤버만 읽기/쓰기, 새 방은 본인이 멤버로 포함될 때만 생성
    match /rooms/{roomId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      allow update: if signedIn() && request.auth.uid in resource.data.members;
      allow delete: if false;

      // 메시지: 방 멤버만 읽기, 보내는 사람=본인일 때만 생성
      match /messages/{msgId} {
        allow read: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.members;
        allow create: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.members &&
          request.resource.data.sender == request.auth.uid;
        allow update: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.members;
        allow delete: if false;
      }
    }
  }
}
